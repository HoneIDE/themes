{
  "$schema": "../schema/theme-schema.json",
  "name": "Monokai",
  "type": "dark",
  "attribution": "Ported from Monokai by Wimer Hazenberg (monokai.pro). MIT License.",
  "colors": {
    "editor.background": "#272822",
    "editor.foreground": "#f8f8f2",
    "editor.selectionBackground": "#49483e",
    "editor.lineHighlightBackground": "#3e3d32",
    "editor.findMatchBackground": "#e6db7440",
    "editor.findMatchHighlightBackground": "#e6db7420",
    "editorCursor.foreground": "#f8f8f0",
    "editorLineNumber.foreground": "#75715e",
    "editorLineNumber.activeForeground": "#f8f8f2",
    "editorGutter.addedBackground": "#a6e22e",
    "editorGutter.modifiedBackground": "#66d9e8",
    "editorGutter.deletedBackground": "#f92672",
    "editorIndentGuide.background": "#3b3a32",
    "editorIndentGuide.activeBackground": "#49483e",
    "editorWhitespace.foreground": "#3b3a32",
    "editorBracketMatch.background": "#49483e80",
    "editorBracketMatch.border": "#66d9e8",

    "activityBar.background": "#1e1f1c",
    "activityBar.foreground": "#f8f8f2",
    "activityBar.inactiveForeground": "#75715e",

    "sideBar.background": "#1e1f1c",
    "sideBar.foreground": "#f8f8f2",
    "sideBarTitle.foreground": "#f8f8f2",
    "sideBarSectionHeader.background": "#272822",

    "titleBar.activeBackground": "#1e1f1c",
    "titleBar.activeForeground": "#f8f8f2",
    "titleBar.inactiveBackground": "#1e1f1c",

    "tab.activeBackground": "#272822",
    "tab.activeForeground": "#f8f8f2",
    "tab.inactiveBackground": "#1e1f1c",
    "tab.inactiveForeground": "#75715e",
    "tab.border": "#1e1f1c",

    "statusBar.background": "#1e1f1c",
    "statusBar.foreground": "#f8f8f2",
    "statusBar.debuggingBackground": "#fd971f",

    "panel.background": "#1e1f1c",
    "panel.border": "#3b3a32",

    "terminal.background": "#272822",
    "terminal.foreground": "#f8f8f2",
    "terminal.ansiBlack": "#272822",
    "terminal.ansiRed": "#f92672",
    "terminal.ansiGreen": "#a6e22e",
    "terminal.ansiYellow": "#f4bf75",
    "terminal.ansiBlue": "#66d9e8",
    "terminal.ansiMagenta": "#ae81ff",
    "terminal.ansiCyan": "#a1efe4",
    "terminal.ansiWhite": "#f8f8f2",
    "terminal.ansiBrightBlack": "#75715e",
    "terminal.ansiBrightRed": "#f92672",
    "terminal.ansiBrightGreen": "#a6e22e",
    "terminal.ansiBrightYellow": "#f4bf75",
    "terminal.ansiBrightBlue": "#66d9e8",
    "terminal.ansiBrightMagenta": "#ae81ff",
    "terminal.ansiBrightCyan": "#a1efe4",
    "terminal.ansiBrightWhite": "#f9f8f5",

    "input.background": "#3b3a32",
    "input.foreground": "#f8f8f2",
    "input.border": "#49483e",
    "input.placeholderForeground": "#75715e",

    "dropdown.background": "#3b3a32",
    "dropdown.foreground": "#f8f8f2",
    "dropdown.border": "#49483e",

    "button.background": "#a6e22e",
    "button.foreground": "#272822",
    "button.hoverBackground": "#89c918",

    "list.activeSelectionBackground": "#49483e",
    "list.activeSelectionForeground": "#f8f8f2",
    "list.hoverBackground": "#3b3a32",
    "list.focusBackground": "#49483e",

    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#49483e80",
    "scrollbarSlider.hoverBackground": "#49483ea0",
    "scrollbarSlider.activeBackground": "#75715e",

    "badge.background": "#a6e22e",
    "badge.foreground": "#272822",

    "minimap.background": "#1e1f1c",
    "minimap.selectionHighlight": "#49483e",
    "minimap.findMatchHighlight": "#e6db7440",

    "diffEditor.insertedTextBackground": "#a6e22e20",
    "diffEditor.removedTextBackground": "#f9267220",

    "notificationCenter.border": "#3b3a32",
    "notifications.background": "#3b3a32",
    "notifications.foreground": "#f8f8f2",

    "commandPalette.background": "#272822",
    "commandPalette.foreground": "#f8f8f2"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#75715e", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#e6db74" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ae81ff" }
    },
    {
      "name": "Boolean/Null",
      "scope": ["constant.language"],
      "settings": { "foreground": "#ae81ff" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#f92672" }
    },
    {
      "name": "Control keyword",
      "scope": ["keyword.control"],
      "settings": { "foreground": "#f92672" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#f92672" }
    },
    {
      "name": "Function declaration",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#a6e22e" }
    },
    {
      "name": "Function call",
      "scope": ["meta.function-call"],
      "settings": { "foreground": "#a6e22e" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#66d9e8" }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#a6e22e" }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.interface"],
      "settings": { "foreground": "#66d9e8", "fontStyle": "italic" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#f8f8f2" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#fd971f", "fontStyle": "italic" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": { "foreground": "#66d9e8" }
    },
    {
      "name": "Constant",
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "#ae81ff" }
    },
    {
      "name": "Tag (HTML/JSX)",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#f92672" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#a6e22e" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#f8f8f2" }
    },
    {
      "name": "Decorator/Annotation",
      "scope": ["meta.decorator", "meta.annotation"],
      "settings": { "foreground": "#a6e22e" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#f92672" }
    },
    {
      "name": "Escape character",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ae81ff" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#a6e22e", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#66d9e8" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#e6db74" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#a6e22e" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#f92672" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#fd971f" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#f92672",
    "type": "#66d9e8",
    "class": "#a6e22e",
    "enum": "#66d9e8",
    "interface": { "foreground": "#66d9e8", "fontStyle": "italic" },
    "struct": "#66d9e8",
    "typeParameter": "#66d9e8",
    "parameter": { "foreground": "#fd971f", "fontStyle": "italic" },
    "variable": "#f8f8f2",
    "variable.readonly": "#ae81ff",
    "property": "#66d9e8",
    "enumMember": "#ae81ff",
    "function": "#a6e22e",
    "method": "#a6e22e",
    "macro": "#f92672",
    "keyword": "#f92672",
    "comment": { "foreground": "#75715e", "fontStyle": "italic" },
    "string": "#e6db74",
    "number": "#ae81ff",
    "regexp": "#f92672",
    "operator": "#f92672",
    "decorator": "#a6e22e"
  }
}
