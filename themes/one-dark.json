{
  "$schema": "../schema/theme-schema.json",
  "name": "One Dark Pro",
  "type": "dark",
  "attribution": "Ported from One Dark Pro by binaryify (github.com/Binaryify/OneDark-Pro). MIT License.",
  "colors": {
    "editor.background": "#282c34",
    "editor.foreground": "#abb2bf",
    "editor.selectionBackground": "#3e4451",
    "editor.lineHighlightBackground": "#2c313c",
    "editor.findMatchBackground": "#e5c07b40",
    "editor.findMatchHighlightBackground": "#e5c07b20",
    "editorCursor.foreground": "#528bff",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#abb2bf",
    "editorGutter.addedBackground": "#98c379",
    "editorGutter.modifiedBackground": "#61afef",
    "editorGutter.deletedBackground": "#e06c75",
    "editorIndentGuide.background": "#3b4048",
    "editorIndentGuide.activeBackground": "#3e4451",
    "editorWhitespace.foreground": "#3b4048",
    "editorBracketMatch.background": "#3e445180",
    "editorBracketMatch.border": "#61afef",

    "activityBar.background": "#21252b",
    "activityBar.foreground": "#d7dae0",
    "activityBar.inactiveForeground": "#4b5263",

    "sideBar.background": "#21252b",
    "sideBar.foreground": "#d7dae0",
    "sideBarTitle.foreground": "#d7dae0",
    "sideBarSectionHeader.background": "#282c34",

    "titleBar.activeBackground": "#21252b",
    "titleBar.activeForeground": "#abb2bf",
    "titleBar.inactiveBackground": "#21252b",

    "tab.activeBackground": "#282c34",
    "tab.activeForeground": "#d7dae0",
    "tab.inactiveBackground": "#21252b",
    "tab.inactiveForeground": "#4b5263",
    "tab.border": "#21252b",

    "statusBar.background": "#21252b",
    "statusBar.foreground": "#9da5b4",
    "statusBar.debuggingBackground": "#e5c07b",

    "panel.background": "#21252b",
    "panel.border": "#3b4048",

    "terminal.background": "#282c34",
    "terminal.foreground": "#abb2bf",
    "terminal.ansiBlack": "#3f4451",
    "terminal.ansiRed": "#e06c75",
    "terminal.ansiGreen": "#98c379",
    "terminal.ansiYellow": "#e5c07b",
    "terminal.ansiBlue": "#61afef",
    "terminal.ansiMagenta": "#c678dd",
    "terminal.ansiCyan": "#56b6c2",
    "terminal.ansiWhite": "#d7dae0",
    "terminal.ansiBrightBlack": "#4f5666",
    "terminal.ansiBrightRed": "#be5046",
    "terminal.ansiBrightGreen": "#98c379",
    "terminal.ansiBrightYellow": "#e5c07b",
    "terminal.ansiBrightBlue": "#61afef",
    "terminal.ansiBrightMagenta": "#c678dd",
    "terminal.ansiBrightCyan": "#56b6c2",
    "terminal.ansiBrightWhite": "#ffffff",

    "input.background": "#1d1f23",
    "input.foreground": "#abb2bf",
    "input.border": "#3e4451",
    "input.placeholderForeground": "#4b5263",

    "dropdown.background": "#1d1f23",
    "dropdown.foreground": "#abb2bf",
    "dropdown.border": "#3e4451",

    "button.background": "#4d78cc",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#3d68bc",

    "list.activeSelectionBackground": "#3e4451",
    "list.activeSelectionForeground": "#d7dae0",
    "list.hoverBackground": "#2c313c",
    "list.focusBackground": "#3e4451",

    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#3e445180",
    "scrollbarSlider.hoverBackground": "#3e4451a0",
    "scrollbarSlider.activeBackground": "#4b5263",

    "badge.background": "#528bff",
    "badge.foreground": "#ffffff",

    "minimap.background": "#21252b",
    "minimap.selectionHighlight": "#3e4451",
    "minimap.findMatchHighlight": "#e5c07b40",

    "diffEditor.insertedTextBackground": "#98c37920",
    "diffEditor.removedTextBackground": "#e06c7520",

    "notificationCenter.border": "#3b4048",
    "notifications.background": "#21252b",
    "notifications.foreground": "#abb2bf",

    "commandPalette.background": "#282c34",
    "commandPalette.foreground": "#abb2bf"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5c6370", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#d19a66" }
    },
    {
      "name": "Boolean/Null",
      "scope": ["constant.language"],
      "settings": { "foreground": "#d19a66" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#c678dd" }
    },
    {
      "name": "Control keyword",
      "scope": ["keyword.control"],
      "settings": { "foreground": "#c678dd" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "name": "Function declaration",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#61afef" }
    },
    {
      "name": "Function call",
      "scope": ["meta.function-call"],
      "settings": { "foreground": "#61afef" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#e5c07b" }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#e5c07b" }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.interface"],
      "settings": { "foreground": "#e5c07b", "fontStyle": "italic" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#abb2bf" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#abb2bf" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": { "foreground": "#e06c75" }
    },
    {
      "name": "Constant",
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "#d19a66" }
    },
    {
      "name": "Tag (HTML/JSX)",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#e06c75" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#d19a66" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#abb2bf" }
    },
    {
      "name": "Decorator/Annotation",
      "scope": ["meta.decorator", "meta.annotation"],
      "settings": { "foreground": "#e5c07b" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "name": "Escape character",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#e06c75", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#61afef" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#98c379" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#e06c75" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#e5c07b" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#e5c07b",
    "type": "#e5c07b",
    "class": "#e5c07b",
    "enum": "#e5c07b",
    "interface": { "foreground": "#e5c07b", "fontStyle": "italic" },
    "struct": "#e5c07b",
    "typeParameter": "#e5c07b",
    "parameter": "#abb2bf",
    "variable": "#abb2bf",
    "variable.readonly": "#d19a66",
    "property": "#e06c75",
    "enumMember": "#d19a66",
    "function": "#61afef",
    "method": "#61afef",
    "macro": "#e06c75",
    "keyword": "#c678dd",
    "comment": { "foreground": "#5c6370", "fontStyle": "italic" },
    "string": "#98c379",
    "number": "#d19a66",
    "regexp": "#98c379",
    "operator": "#56b6c2",
    "decorator": "#e5c07b"
  }
}
