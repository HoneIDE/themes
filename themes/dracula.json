{
  "$schema": "../schema/theme-schema.json",
  "name": "Dracula",
  "type": "dark",
  "attribution": "Ported from Dracula Theme by Zeno Rocha (draculatheme.com). MIT License.",
  "colors": {
    "editor.background": "#282a36",
    "editor.foreground": "#f8f8f2",
    "editor.selectionBackground": "#44475a",
    "editor.lineHighlightBackground": "#44475a",
    "editor.findMatchBackground": "#ffb86c40",
    "editor.findMatchHighlightBackground": "#ffb86c20",
    "editorCursor.foreground": "#f8f8f0",
    "editorLineNumber.foreground": "#6272a4",
    "editorLineNumber.activeForeground": "#f8f8f2",
    "editorGutter.addedBackground": "#50fa7b",
    "editorGutter.modifiedBackground": "#8be9fd",
    "editorGutter.deletedBackground": "#ff5555",
    "editorIndentGuide.background": "#44475a",
    "editorIndentGuide.activeBackground": "#6272a4",
    "editorWhitespace.foreground": "#44475a",
    "editorBracketMatch.background": "#44475a80",
    "editorBracketMatch.border": "#8be9fd",

    "activityBar.background": "#21222c",
    "activityBar.foreground": "#f8f8f2",
    "activityBar.inactiveForeground": "#6272a4",

    "sideBar.background": "#21222c",
    "sideBar.foreground": "#f8f8f2",
    "sideBarTitle.foreground": "#f8f8f2",
    "sideBarSectionHeader.background": "#282a36",

    "titleBar.activeBackground": "#21222c",
    "titleBar.activeForeground": "#f8f8f2",
    "titleBar.inactiveBackground": "#21222c",

    "tab.activeBackground": "#282a36",
    "tab.activeForeground": "#f8f8f2",
    "tab.inactiveBackground": "#21222c",
    "tab.inactiveForeground": "#6272a4",
    "tab.border": "#21222c",

    "statusBar.background": "#21222c",
    "statusBar.foreground": "#f8f8f2",
    "statusBar.debuggingBackground": "#ffb86c",

    "panel.background": "#21222c",
    "panel.border": "#44475a",

    "terminal.background": "#282a36",
    "terminal.foreground": "#f8f8f2",
    "terminal.ansiBlack": "#21222c",
    "terminal.ansiRed": "#ff5555",
    "terminal.ansiGreen": "#50fa7b",
    "terminal.ansiYellow": "#f1fa8c",
    "terminal.ansiBlue": "#bd93f9",
    "terminal.ansiMagenta": "#ff79c6",
    "terminal.ansiCyan": "#8be9fd",
    "terminal.ansiWhite": "#f8f8f2",
    "terminal.ansiBrightBlack": "#6272a4",
    "terminal.ansiBrightRed": "#ff6e6e",
    "terminal.ansiBrightGreen": "#69ff94",
    "terminal.ansiBrightYellow": "#ffffa5",
    "terminal.ansiBrightBlue": "#d6acff",
    "terminal.ansiBrightMagenta": "#ff92df",
    "terminal.ansiBrightCyan": "#a4ffff",
    "terminal.ansiBrightWhite": "#ffffff",

    "input.background": "#44475a",
    "input.foreground": "#f8f8f2",
    "input.border": "#6272a4",
    "input.placeholderForeground": "#6272a4",

    "dropdown.background": "#44475a",
    "dropdown.foreground": "#f8f8f2",
    "dropdown.border": "#6272a4",

    "button.background": "#bd93f9",
    "button.foreground": "#282a36",
    "button.hoverBackground": "#a87ff7",

    "list.activeSelectionBackground": "#44475a",
    "list.activeSelectionForeground": "#f8f8f2",
    "list.hoverBackground": "#44475a",
    "list.focusBackground": "#44475a",

    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#44475a80",
    "scrollbarSlider.hoverBackground": "#44475aa0",
    "scrollbarSlider.activeBackground": "#6272a4",

    "badge.background": "#bd93f9",
    "badge.foreground": "#282a36",

    "minimap.background": "#21222c",
    "minimap.selectionHighlight": "#44475a",
    "minimap.findMatchHighlight": "#ffb86c40",

    "diffEditor.insertedTextBackground": "#50fa7b20",
    "diffEditor.removedTextBackground": "#ff555520",

    "notificationCenter.border": "#44475a",
    "notifications.background": "#44475a",
    "notifications.foreground": "#f8f8f2",

    "commandPalette.background": "#282a36",
    "commandPalette.foreground": "#f8f8f2"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6272a4", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#f1fa8c" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#bd93f9" }
    },
    {
      "name": "Boolean/Null",
      "scope": ["constant.language"],
      "settings": { "foreground": "#bd93f9" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Control keyword",
      "scope": ["keyword.control"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Function declaration",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "Function call",
      "scope": ["meta.function-call"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#8be9fd" }
    },
    {
      "name": "Class",
      "scope": ["entity.name.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#8be9fd" }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.interface"],
      "settings": { "foreground": "#8be9fd", "fontStyle": "italic" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#f8f8f2" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#ffb86c", "fontStyle": "italic" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": { "foreground": "#8be9fd" }
    },
    {
      "name": "Constant",
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "#bd93f9" }
    },
    {
      "name": "Tag (HTML/JSX)",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#f8f8f2" }
    },
    {
      "name": "Decorator/Annotation",
      "scope": ["meta.decorator", "meta.annotation"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Escape character",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ff79c6" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#bd93f9", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#8be9fd" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#f1fa8c" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#50fa7b" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff5555" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#ffb86c" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#8be9fd",
    "type": "#8be9fd",
    "class": "#8be9fd",
    "enum": "#8be9fd",
    "interface": { "foreground": "#8be9fd", "fontStyle": "italic" },
    "struct": "#8be9fd",
    "typeParameter": "#8be9fd",
    "parameter": { "foreground": "#ffb86c", "fontStyle": "italic" },
    "variable": "#f8f8f2",
    "variable.readonly": "#bd93f9",
    "property": "#8be9fd",
    "enumMember": "#bd93f9",
    "function": "#50fa7b",
    "method": "#50fa7b",
    "macro": "#ff5555",
    "keyword": "#ff79c6",
    "comment": { "foreground": "#6272a4", "fontStyle": "italic" },
    "string": "#f1fa8c",
    "number": "#bd93f9",
    "regexp": "#ff79c6",
    "operator": "#ff79c6",
    "decorator": "#50fa7b"
  }
}
